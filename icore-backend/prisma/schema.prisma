generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  username      String  @unique
  password      String
  firstName     String
  lastName      String
  contactNumber String?
  gender        String?
  department    String?
  batch         String?
  pitch         String?
  regNumber     String? @unique
  refreshToken  String?

  // Additional profile fields
  bio         String? // Biography/description
  title       String? // Professional title
  location    String? // Geographic location
  dateOfBirth DateTime? // Date of birth

  // Professional information
  company           String? // Current company
  institution       String? // Educational institution
  fieldOfStudy      String? // Field of study
  graduationYear    String? // Graduation year
  yearsOfExperience Int? // Years of professional experience

  // Profile images
  avatarUrl     String? // Profile picture URL
  coverImageUrl String? // Cover image URL

  // Social media links
  website   String? // Personal website
  github    String? // GitHub profile
  linkedin  String? // LinkedIn profile
  youtube   String? // YouTube channel
  instagram String? // Instagram profile
  twitter   String? // Twitter profile

  // JSON fields for complex data
  experiences Json? // Work experience as JSON array
  skills      Json? // Skills as JSON array

  role           Role      @default(GENERAL)
  status         Status    @default(ACTIVE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projectMembers Member[]
  projects       Project[]
  supervisedProjects Project[] @relation("ProjectSupervisors")

  @@map("users")
}

model Project {
  id           String        @id @default(uuid())
  name         String
  description  String
  type         ProjectType
  startDate    DateTime
  endDate      DateTime?
  tags         String[]
  techDetails  String?
  technologies String[]
  references   String[]
  papers       String[]
  photos       String[]
  documents    String[]
  youtubeURL   String?
  websiteURL   String?
  githubURL    String?
  ownerId      String
  isVisible    Boolean       @default(false)
  status       Status        @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  guestMembers GuestMember[]
  members      Member[]
  owner        User          @relation(fields: [ownerId], references: [id])
  supervisors  User[]        @relation("ProjectSupervisors")

  @@map("projects")
}

model Member {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@map("project_members")
}

model GuestMember {
  id        String      @id @default(uuid())
  name      String
  email     String
  role      ProjectRole
  projectId String
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id])
}

enum Role {
  GENERAL
  FULL
  COMMITTEE
  ACADEMIC
  INDUSTRY
}

enum Status {
  ACTIVE
  PENDING
  INACTIVE
}

enum ProjectRole {
  LEADER
  MEMBER
  SUPERVISOR
  CONTRIBUTOR
}

enum ProjectType {
  RESEARCH
  DESIGN
  DEVELOPMENT
  REXTRO_2025
  OTHER
  FYP
}
